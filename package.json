{
  "name": "yuki",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "yuki — a quiet reading library",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.22.3",
    "pnpm": ">=10.11.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test:epub": "tsx tests/epub-smoke.ts",
    "test:layout": "tsx tests/layout-smoke.ts",
    "test:position": "tsx tests/position-smoke.ts",
    "test:library": "tsx tests/library-smoke.ts",
    "test": "pnpm test:epub",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "^4.5.0",
    "fflate": "^0.8.2",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "^8.0.0",
    "pdfjs-dist": "^4.0.0",
    "postcss": "8.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "react-router": "8.3.0",
    "tailwind-merge": "3.6.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "playwright-core": "1.62.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.0.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0"
  }
}
